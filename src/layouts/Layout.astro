---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'The portfolio of Patrick Allan Ramo, web development student and aspiring frontend developer.' } = Astro.props;

const links = [
	{ label: 'Education', href: '/#education' },
	{ label: 'Projects', href: '/#projects' },
	{ label: 'Skills', href: '/#skills' },
	{ label: 'Interests', href: '/#hobbies' },
	{ label: 'Get in touch', href: '/#contact', cta: true },
] as const;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f5dabf" />
		<title>{title} | Patrick Allan Ramo</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="navbar site-header">
			<div class="container nav-inner">
				<a class="brand" href="/#top" aria-label="Patrick Allan Ramo, home">
					<span class="brand-dot" aria-hidden="true"></span>
					<span>Patrick Allan Ramo</span>
				</a>
				<nav aria-label="Primary navigation">
					<ul class="nav-links">
						{links.map((link) => (
							<li>
								<a href={link.href} class={link.cta ? 'nav-cta' : undefined}>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>
		</header>
		<main id="main">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="footer-inner">
				<p>© {new Date().getFullYear()} Patrick Allan Ramo</p>
				<a href="#main">Back to top ↑</a>
			</div>
		</footer>
	</body>
</html>
