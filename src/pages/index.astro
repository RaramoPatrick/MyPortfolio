---
import ProjectDescription from '../components/ProjectDescription.astro';
import ProjectImage from '../components/ProjectImage.astro';
import { projects } from '../data/projects';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
	<section class="hero" id="top">
		<div class="container hero-grid">
			<div class="hero-main">
				<div>
					<div class="badge-row">
						<span class="location-badge">4th-year Computer Engineering student</span>
						<span class="status-badge">Aspiring frontend developer</span>
					</div>
					<h1 class="hero-title">
						Hi, I’m <span>Patrick Allan Ramo</span> — learning to build thoughtful, responsive websites.
					</h1>
					<p class="hero-tagline">
						I enjoy turning ideas into clean, accessible web pages. I’m currently focused on
						semantic HTML5, Flexbox, and CSS Grid while developing projects for my portfolio.
					</p>
				</div>
				<div class="hero-actions">
					<a href="#projects" class="btn btn-primary">Explore my projects</a>
					<a href="#education" class="btn btn-secondary">About my studies</a>
				</div>
			</div>

			<aside class="hero-side" aria-label="Profile">
				<div class="profile-card">
					<div class="avatar-ring">
						<img
							src="/images/profile.jpg"
							alt="Portrait of Patrick Allan Ramo"
							class="avatar-img"
							width="240"
							height="240"
							fetchpriority="high"
						/>
					</div>
					<h2>Patrick Allan Ramo</h2>
					<p class="profile-role">Computer Engineering student</p>
					<div class="profile-focus">
						<span class="skill-pill">Semantic HTML</span>
						<span class="skill-pill">Responsive CSS</span>
						<span class="skill-pill">Flexbox &amp; Grid</span>
					</div>
				</div>
			</aside>
		</div>
	</section>

	<section id="education">
		<div class="container">
			<div class="section-header">
				<span class="section-kicker">Academic journey</span>
				<h2 class="section-title">Education</h2>
				<p class="section-desc">
					I’m a fourth-year Computer Engineering student building skills across software,
					hardware, and accessible web design.
				</p>
			</div>
			<div class="edu-grid">
				<article class="card">
					<div class="edu-header">
						<div>
							<h3 class="edu-school">Current studies</h3>
							<p class="edu-degree">Computer Engineering</p>
						</div>
						<span class="date-pill">4th year</span>
					</div>
					<p class="edu-details">
						My current focus is semantic HTML, responsive CSS, Flexbox, CSS Grid, and building
						real-world projects for my portfolio.
					</p>
				</article>
			</div>
		</div>
	</section>

	<section id="projects">
		<div class="container">
			<div class="section-header">
				<span class="section-kicker">Selected work</span>
				<h2 class="section-title">Projects</h2>
				<p class="section-desc">
					A selection of my portfolio work, including a tile-cutting system and a flood-hazard
					classification tool.
				</p>
			</div>
			<div class="projects-grid">
				{projects.map((project) => (
					<article class="card project-card">
						{project.image && (
							<div class="project-image-wrap">
								<ProjectImage src={project.image} alt={project.imageAlt ?? ''} />
								<span class="project-category">{project.category}</span>
							</div>
						)}
						{!project.image && (
							<div class={`project-banner banner-${project.theme}`}>
								<span class="project-category">{project.category}</span>
							</div>
						)}
						<div class="project-body">
							<h3 class="project-title">{project.title}</h3>
							<ProjectDescription parts={project.description} />
							{project.caution && <p class="project-caution">{project.caution}</p>}
							{project.link && (
								<div class="project-links">
									<a
										class="project-link"
										href={project.link}
										target="_blank"
										rel="noopener noreferrer"
									>
										{project.linkLabel} ↗
									</a>
								</div>
							)}
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="experience">
		<div class="container">
			<div class="section-header">
				<span class="section-kicker">Learning by doing</span>
				<h2 class="section-title">Current focus</h2>
				<p class="section-desc">
					I’m developing software, hardware, and creative skills through hands-on projects and
					course training.
				</p>
			</div>
			<div class="timeline">
				<article class="card work-card">
					<div class="work-meta">
						<span class="work-date">Ongoing</span>
						<span class="work-type">Personal learning</span>
					</div>
					<div class="work-content">
						<h3>Frontend development</h3>
						<p class="work-org">Portfolio and practice projects</p>
						<ul class="work-list">
							<li>Practice semantic HTML and accessible page structure.</li>
							<li>Build responsive layouts with Flexbox, CSS Grid, and media queries.</li>
							<li>Explore UI design concepts and strengthen problem-solving skills.</li>
						</ul>
					</div>
				</article>
				<article class="card work-card">
					<div class="work-meta">
						<span class="work-date">June 19–23, 2023</span>
						<span class="work-type">40-hour course</span>
					</div>
					<div class="work-content">
						<h3>40-hour Python Programming Essentials Course Training</h3>
						<p class="work-org">Completed course training</p>
						<ul class="work-list">
							<li>
								Completed structured training to build a foundation in Python programming.
							</li>
							<li>
								Practiced programming concepts through course exercises and problem-solving.
							</li>
						</ul>
						<div class="certificate-preview project-image-wrap">
							<ProjectImage
								src="/certificates/python-programming-essentials.png"
								alt="Certificate of participation for the 40-hour Python Programming Essentials Course Training"
								width={1684}
								height={1191}
							/>
						</div>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section id="skills">
		<div class="container">
			<div class="section-header">
				<span class="section-kicker">Capabilities</span>
				<h2 class="section-title">Skills &amp; tools</h2>
				<p class="section-desc">
					Topics I’m learning and practicing as I grow as a frontend developer.
				</p>
			</div>
			<div class="skills-grid">
				<article class="card">
					<h3 class="skill-group-title">
						<span class="skill-icon-box" aria-hidden="true">&lt;/&gt;</span>
						Frontend foundations
					</h3>
					<div class="pill-cloud">
						<span class="skill-pill">Semantic HTML5</span>
						<span class="skill-pill">Responsive CSS</span>
						<span class="skill-pill">Flexbox</span>
						<span class="skill-pill">CSS Grid</span>
						<span class="skill-pill">Media queries</span>
					</div>
				</article>
				<article class="card">
					<h3 class="skill-group-title">
						<span class="skill-icon-box" aria-hidden="true">⌘</span>
						Engineering &amp; hardware projects
					</h3>
					<div class="pill-cloud">
						<span class="skill-pill">Arduino-based projects</span>
						<span class="skill-pill">Electrical projects</span>
						<span class="skill-pill">Hardware projects</span>
					</div>
				</article>
				<article class="card">
					<h3 class="skill-group-title">
						<span class="skill-icon-box" aria-hidden="true">✦</span>
						Creative software
					</h3>
					<div class="pill-cloud">
						<span class="skill-pill">Adobe Photoshop</span>
						<span class="skill-pill">Adobe Premiere Pro</span>
						<span class="skill-pill">Adobe After Effects</span>
					</div>
				</article>
				<article class="card">
					<h3 class="skill-group-title">
						<span class="skill-icon-box" aria-hidden="true">✦</span>
						Working habits
					</h3>
					<div class="pill-cloud">
						<span class="skill-pill">Git &amp; deployment</span>
						<span class="skill-pill">Accessible design</span>
						<span class="skill-pill">UI exploration</span>
						<span class="skill-pill">Problem-solving</span>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section id="hobbies">
		<div class="container">
			<div class="section-header">
				<span class="section-kicker">Beyond the classroom</span>
				<h2 class="section-title">Interests</h2>
				<p class="section-desc">
					Things that keep me curious and creative outside of building web pages.
				</p>
			</div>
			<div class="hobbies-grid">
				<article class="card hobby-card">
					<div class="hobby-emoji" aria-hidden="true">✎</div>
					<h3>Exploring UI design</h3>
					<p>I enjoy exploring interface ideas and how small design choices improve usability.</p>
				</article>
				<article class="card hobby-card">
					<div class="hobby-emoji" aria-hidden="true">⌘</div>
					<h3>Sharpening problem-solving</h3>
					<p>I like breaking ideas into manageable steps and learning from each project.</p>
				</article>
				<article class="card hobby-card">
					<div class="hobby-emoji" aria-hidden="true">⌕</div>
					<h3>Hardware troubleshooting</h3>
					<p>I enjoy diagnosing hardware issues and finding practical solutions.</p>
				</article>
				<article class="card hobby-card">
					<div class="hobby-emoji" aria-hidden="true">⚡</div>
					<h3>Electrical troubleshooting</h3>
					<p>I’m interested in identifying and resolving electrical project issues.</p>
				</article>
			</div>
		</div>
	</section>

	<section id="contact" class="footer-section">
		<div class="container">
			<div class="contact-banner">
				<div>
					<span class="section-kicker">Let’s connect</span>
					<h2>Interested in collaborating or talking about web development?</h2>
					<p>
						I’d be glad to hear from you about web development, engineering projects, or other
						collaborations.
					</p>
				</div>
				<div class="contact-links">
					<a href="mailto:ramopatrickallan@gmail.com" class="contact-item">
						<span>ramopatrickallan@gmail.com</span>
						<span aria-hidden="true">Email ↗</span>
					</a>
					<a href="/contact/" class="contact-item">
						<span>Open contact page</span>
						<span aria-hidden="true">↗</span>
					</a>
					<a href="/projects/" class="contact-item">
						<span>View project details</span>
						<span aria-hidden="true">↗</span>
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>
