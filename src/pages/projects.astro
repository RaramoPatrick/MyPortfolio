---
import ProjectDescription from '../components/ProjectDescription.astro';
import ProjectImage from '../components/ProjectImage.astro';
import { projects } from '../data/projects';
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Projects"
	description="Selected projects by Patrick Allan Ramo."
>
	<section class="page-intro section-shell">
		<p class="eyebrow">Selected work</p>
		<h1>Projects<span>.</span></h1>
		<p>Small steps, real projects, and plenty of room to keep improving.</p>
	</section>

	<section class="projects-grid section-shell" aria-label="Installation of FreeWifi 4 All under DICT Projects">
		{projects.map((project) => (
			<article class="project-card">
				{project.image ? (
					<div class="project-image-wrap">
						<ProjectImage src={project.image} alt={project.imageAlt ?? ''} />
						<span class="project-category">{project.category}</span>
					</div>
				) : (
					<div class={`project-banner banner-${project.theme}`}>
						<span class="project-category">{project.category}</span>
					</div>
				)}
				<div class="project-copy">
					<h2>{project.title}</h2>
					<ProjectDescription parts={project.description} />
					{project.caution && <p class="project-caution">{project.caution}</p>}
					{project.link && (
						<a
							class="project-link"
							href={project.link}
							target="_blank"
							rel="noopener noreferrer"
						>
							{project.linkLabel} ↗
						</a>
					)}
				</div>
			</article>
		))}
	</section>
</Layout>
