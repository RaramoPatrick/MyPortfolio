---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contact"
	description="Get in touch with Patrick Allan Ramo."
>
	<section class="page-intro section-shell contact-intro">
		<p class="eyebrow">Say hello</p>
		<h1>Get in touch<span>.</span></h1>
		<p>
			I’m always glad to connect about web development, Computer Engineering, or project ideas.
		</p>
	</section>

	<section class="contact-card section-shell" aria-labelledby="contact-title">
		<div>
			<p class="eyebrow">Let’s connect</p>
			<h2 id="contact-title">Have something in mind?</h2>
			<p>
				Email me at <a href="mailto:ramopatrickallan@gmail.com">ramopatrickallan@gmail.com</a>.
			</p>
		</div>
		<a class="button button-primary" href="mailto:ramopatrickallan@gmail.com">
			Email Patrick <span aria-hidden="true">↗</span>
		</a>
	</section>
</Layout>
