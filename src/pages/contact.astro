---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contact"
	description="Get in touch with Patrick Allan Ramo."
>
	<section class="page-intro section-shell contact-intro">
		<p class="eyebrow">Say hello</p>
		<h1>Get in touch<span>.</span></h1>
		<p>
			I’m always glad to connect with fellow learners, talk about web development, or hear about
			interesting projects.
		</p>
	</section>

	<section class="contact-card section-shell" aria-labelledby="contact-title">
		<div>
			<p class="eyebrow">Let’s connect</p>
			<h2 id="contact-title">Have something in mind?</h2>
			<p>
				Add your preferred email address or social profile here to give visitors a direct way to
				reach you. The original reference included sample contact details, so they have not been
				presented as real links.
			</p>
		</div>
		<a class="button button-primary" href="/">Back to home <span aria-hidden="true">→</span></a>
	</section>
</Layout>
